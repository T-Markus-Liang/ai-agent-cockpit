{
  "name": "personal-ai-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal AI OS control plane for local agent sessions, WeChat entry and Cezar cockpit",
  "scripts": {
    "sessions": "node scripts/control-plane.mjs",
    "control-plane": "node gateway/control-plane.mjs",
    "goals": "node gateway/goals.mjs",
    "goal-status": "node scripts/goals.mjs",
    "test:goals": "node --test tests/goal-*.test.mjs tests/verification-gate.test.mjs",
    "test:goals-live": "node scripts/test-goals-live.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:memory-service": ".venv-memory/bin/python -m unittest discover -s tests -p 'memory_service_test.py' -v",
    "test:memory-live": "node scripts/test-memory-live.mjs",
    "test:memory-kimi": "node scripts/test-memory-kimi.mjs",
    "test:memory-recovery": "MEMORY_RECOVERY_TEST=1 node scripts/test-memory-recovery.mjs",
    "eval:control-plane": "node evals/control-plane-regression.mjs",
    "test:control-plane": "node --test tests/control-plane.test.mjs tests/control-plane-http.test.mjs"
  }
}
