<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.markus.ai-agent-cockpit.control-plane</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/markus/ai-agent-cockpit/gateway/control-plane.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/markus</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/Users/markus/.opencode/bin:/Users/markus/.local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/markus/ai-agent-cockpit</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/markus/ai-agent-cockpit/logs/control-plane-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/markus/ai-agent-cockpit/logs/control-plane-launchd.err.log</string>
</dict>
</plist>
